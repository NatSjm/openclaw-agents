# Template for the private file .local/openclaw.env (ignored by Git).
# setup.ps1 copies it there and fills the two generated tokens for you.
# Never commit real values; never paste them into chat or screenshots.

# --- You provide these -------------------------------------------------------
# OpenAI Platform API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Telegram bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# --- Generated by setup.ps1 (random, local only) -----------------------------
# Login token for the OpenClaw dashboard at http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Bearer token the external A2A client (scripts/a2a_client.py) uses.
A2A_CLIENT_TOKEN=
