{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "allowTailscale": false,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "terminal": {
      "enabled": false
    },
    "cliAgents": {
      "enabled": false
    },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "skills": [],
      "heartbeat": {
        "every": "0m"
      },
      "workspace": "/project/openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.5"
      },
      "models": {
        "openai/gpt-5.5": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "systemAgent": {
        "agentId": "main"
      },
      "subagents": {
        "allowAgents": [
          "researcher",
          "writer"
        ],
        "requireAgentId": true,
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 2,
        "maxConcurrent": 2,
        "runTimeoutSeconds": 600,
        "delegationMode": "suggest"
      },
      "compaction": {
        "memoryFlush": {
          "enabled": true
        }
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "name": "Coordinator",
        "workspace": "/project/openclaw/workspace",
        "identity": {
          "name": "Coordinator",
          "emoji": "🧭",
          "theme": "Organised, brief, and accountable."
        },
        "memory": {
          "search": {
            "extraPaths": [
              "/project/openclaw/workspace/knowledge"
            ]
          }
        }
      },
      "researcher": {
        "name": "Researcher",
        "workspace": "/project/openclaw/workspace/agents/researcher",
        "identity": {
          "name": "Researcher",
          "emoji": "🔎",
          "theme": "Curious, sceptical, and source-driven."
        },
        "memory": {
          "search": {
            "extraPaths": [
              "/project/openclaw/workspace/knowledge"
            ]
          }
        },
        "tools": {
          "deny": [
            "sessions_spawn",
            "sessions_yield",
            "subagents"
          ]
        }
      },
      "writer": {
        "name": "Writer",
        "workspace": "/project/openclaw/workspace/agents/writer",
        "identity": {
          "name": "Writer",
          "emoji": "✍️",
          "theme": "Clear, structured, and faithful to sources."
        },
        "memory": {
          "search": {
            "extraPaths": [
              "/project/openclaw/workspace/knowledge"
            ]
          }
        },
        "tools": {
          "deny": [
            "group:web",
            "sessions_spawn",
            "sessions_yield",
            "subagents"
          ]
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram"
      }
    },
    {
      "agentId": "researcher",
      "match": {
        "channel": "a2a",
        "peer": {
          "kind": "direct",
          "id": "homework-client"
        }
      }
    }
  ],
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    },
    "a2a": {
      "enabled": true,
      "exposeAgents": [
        "researcher"
      ],
      "replyTimeoutMs": 300000,
      "peers": {
        "homework-client": {
          "token": "${A2A_CLIENT_TOKEN}"
        }
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "read",
      "write",
      "group:memory",
      "group:web",
      "sessions_spawn",
      "sessions_yield",
      "subagents"
    ],
    "deny": [
      "exec",
      "process",
      "edit",
      "apply_patch",
      "group:automation",
      "group:ui",
      "group:messaging",
      "group:nodes",
      "sessions_send",
      "*__*"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "elevated": {
      "enabled": false
    },
    "sessions": {
      "visibility": "tree"
    },
    "agentToAgent": {
      "enabled": false
    },
    "codeMode": {
      "enabled": false
    },
    "toolSearch": false,
    "web": {
      "search": {
        "enabled": true,
        "provider": "parallel-free"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "browser": {
    "enabled": false
  },
  "cron": {
    "enabled": false
  },
  "hooks": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://jaeger:4318",
      "protocol": "http/protobuf",
      "serviceName": "openclaw-research-team",
      "traces": true,
      "metrics": false,
      "logs": false,
      "sampleRate": 1,
      "flushIntervalMs": 5000,
      "captureContent": true
    }
  },
  "plugins": {
    "entries": {
      "parallel": {
        "enabled": true
      },
      "diagnostics-otel": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "a2a": {
        "enabled": true
      },
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "codex": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "telemetry": {
    "enabled": false
  },
  "memory": {
    "citations": "on",
    "search": {
      "enabled": true,
      "provider": "none",
      "sources": [
        "memory"
      ]
    }
  }
}
