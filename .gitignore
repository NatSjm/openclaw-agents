.DS_Store
# Private dotenv values stay local; commit only the credential-free example.
.env
.env.*
!.env.example
.local/
.openclaw/
*.pem
*.key
*.db
*.db-*
*.sqlite*
*.log
# OpenClaw creates these alongside the tracked active native config.
config/openclaw.json.bak*
config/openclaw.json.last-good
config/openclaw.json.rejected.*
config/openclaw.json.tmp*
# Account metadata and backups stay private even though settings are versioned.
config/*.private.json
config/*.private.json.*
**/output/
**/memory/
__pycache__/
*.pyc
node_modules/
# Live agent memory, reports and per-device Obsidian state stay local.
# Templates (MEMORY.template.md) are tracked; setup copies them to MEMORY.md.
openclaw/workspace/**/MEMORY.md
openclaw/workspace/reports/
**/.obsidian/workspace*.json
**/.obsidian/cache/
**/.obsidian/plugins/
**/.trash/
.idea/
.vscode/
workspace-snapshot/
